{
  "name": "fb-lead-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c green,cyan \"npm:server\" \"npm:client\"",
    "search-app": "concurrently -n SEARCH-API,SEARCH-UI -c green,cyan \"APP_ROLE=search PORT=8788 node server/index.js\" \"VITE_APP_ROLE=search VITE_API_PORT=8788 vite --port 5174\"",
    "autopost-app": "concurrently -n POST-API,POST-UI -c green,cyan \"APP_ROLE=autopost PORT=8787 node server/index.js\" \"VITE_APP_ROLE=autopost VITE_API_PORT=8787 vite --port 5173\"",
    "server": "node server/index.js",
    "worker": "node server/worker.js",
    "client": "vite",
    "login": "node server/login.js",
    "scrape:test": "node server/scraper.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint server/pipeline server/db server/migrations server/routes server/services server/adapters server/config server/maintenance server/accounts.js server/browserLauncher.js tests src/api.js src/components/OwnerDatabaseView.jsx src/components/owner",
    "migrate:owners": "node server/migrations/migrate-owner-pipeline.js",
    "verify:migration": "node server/migrations/verify-owner-pipeline.js",
    "rollback:migration": "node server/migrations/rollback-owner-pipeline.js",
    "deduplicate:owners": "node server/migrations/resolve-existing-duplicates.js",
    "hydrate:prices": "node server/migrations/hydrate-missing-prices.js",
    "seed:transit": "node server/maintenance/seed-transit-reference.js",
    "backfill:transit": "node server/migrations/backfill-transit-stations.js",
    "backup:data": "node server/maintenance/backup-local-data.js",
    "verify:backup": "node server/maintenance/verify-local-backup.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
