# ── Gemini AI (สำหรับโหมดคัดกรอง AI) ──────────────────────────────
# สมัคร/ออก key ฟรีได้ที่ https://aistudio.google.com/app/apikey
# เว้นว่างได้ — ระบบจะใช้โหมด Keyword แทน
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Facebook (ดึงโพสต์จากกลุ่ม) ───────────────────────────────────
# กลุ่มตั้งต้น (คั่นด้วย , ) — ปกติแก้ผ่านปุ่ม ⚙️ กลุ่ม ในหน้าเว็บแทน
FB_GROUP_URLS=https://www.facebook.com/groups/condoowner

# ── ตัวเลือก scraper (ไม่ใส่ก็ได้) ────────────────────────────────
# HEADLESS=false        # เปิดให้เห็นเบราว์เซอร์ตอน scrape (ดีบั๊ก)
# SCRAPER_SCROLLS=6     # จำนวนครั้งที่เลื่อนหน้าเพื่อโหลดโพสต์
# SCRAPER_CONCURRENCY=3 # จำนวนกลุ่มที่ค้นหาพร้อมกัน (1-6, ใช้เน็ต/แรมเพิ่มขึ้น)
# SCRAPER_SCROLL_DISTANCE=4500 # ระยะเลื่อนต่อครั้ง
# SCRAPER_SCROLL_WAIT_MS=900   # เวลารอหลังเลื่อน (ต่ำสุด 350 ms)
# SCRAPER_KNOWN_STOP_STEPS=3   # หยุดเมื่อเจอเฉพาะโพสต์เดิมติดกันกี่ช่วง
# DEBUG_SCRAPER=1       # เซฟ screenshot + html ลง scratch-debug/

# พอร์ตของ backend (ไม่ต้องแก้ก็ได้)
PORT=8787

# ── ฟีเจอร์สถาปัตยกรรมใหม่ (ปิดไว้จนกว่าจะผ่านการย้ายข้อมูล) ────────
PROPERTY_V2_ENABLED=false
PROJECT_PROVIDER_ENABLED=false
LOCAL_AUTH_ENABLED=false

# ── Google Sheets (ผ่าน Google Apps Script Web App) ───────────────
# ใส่ URL ที่ลงท้ายด้วย /exec หลัง Deploy Apps Script เป็น Web App
GOOGLE_SHEETS_WEB_APP_URL=
