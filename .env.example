# ── Gemini AI (สำหรับโหมดคัดกรอง AI) ──────────────────────────────
# สมัคร/ออก key ฟรีได้ที่ https://aistudio.google.com/app/apikey
# เว้นว่างได้ — ระบบจะใช้โหมด Keyword แทน
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Facebook (ดึงโพสต์จากกลุ่ม) ───────────────────────────────────
# กลุ่มตั้งต้น (คั่นด้วย , ) — ปกติแก้ผ่านปุ่ม ⚙️ กลุ่ม ในหน้าเว็บแทน
FB_GROUP_URLS=https://www.facebook.com/groups/condoowner

# ── ตัวเลือก scraper (ไม่ใส่ก็ได้) ────────────────────────────────
# HEADLESS=false        # เปิดให้เห็นเบราว์เซอร์ตอน scrape (ดีบั๊ก)
# SCRAPER_SCROLLS=6     # จำนวนครั้งที่เลื่อนหน้าเพื่อโหลดโพสต์
# DEBUG_SCRAPER=1       # เซฟ screenshot + html ลง scratch-debug/

# พอร์ตของ backend (ไม่ต้องแก้ก็ได้)
PORT=8787
